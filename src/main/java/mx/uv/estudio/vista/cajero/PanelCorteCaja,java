package mx.uv.estudio.vista.cajero;

import java.math.BigDecimal;
import java.sql.SQLException;
import java.util.Optional;
import javax.swing.JButton;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JTextField;
import mx.uv.estudio.modelo.ReglaException;
import mx.uv.estudio.modelo.Turno;
import mx.uv.estudio.modelo.Usuario;
import mx.uv.estudio.servicio.CajaService;
import mx.uv.estudio.util.Ui;
import mx.uv.estudio.vista.MainFrame;
import mx.uv.estudio.vista.Pantalla;

/** HU22 · Corte de caja al final del turno para conciliar ingresos. */
public class PanelCorteCaja extends Pantalla {

    private final CajaService cajaService = new CajaService();

    public PanelCorteCaja(Usuario usuario, MainFrame main) {
        super(usuario, main);
    }

    @Override
    protected void construir() throws SQLException {
        add(Ui.titulo("Corte de caja"));
        add(Ui.tenue("Conciliación de ingresos al final del turno. Muestra el fondo más los cobros en efectivo."), "gapbottom 10");

        Optional<Turno> turnoOpt = cajaService.turnoDeHoy();
        if (turnoOpt.isEmpty()) {
            JPanel aviso = Ui.tarjeta("wrap 1", "[grow]");
            aviso.add(new JLabel("No hay un turno abierto hoy para realizar el corte."));
            add(aviso, "w 420!");
        } else {
            add(formularioCorte(turnoOpt.get()), "w 420!");
        }
    }

    private JPanel formularioCorte(Turno turno) throws SQLException {
        JPanel p = Ui.tarjeta("wrap 1, fillx", "[grow,fill]");
        p.add(Ui.subtitulo("Cierre de turno"));

        final BigDecimal efectivoEsperado = cajaService.calcularEfectivoEsperado(turno);

        p.add(new JLabel("Efectivo esperado (Fondo + Cobros en efectivo):"));
        JLabel lblEsperado = Ui.titulo(Ui.dinero(efectivoEsperado));
        lblEsperado.setForeground(Ui.ACENTO);
        p.add(lblEsperado);

        p.add(new JLabel("Efectivo contado físicamente en caja:"));
        JTextField txtEfectivoContado = new JTextField();
        p.add(txtEfectivoContado);

        JButton btnRealizarCorte = Ui.primario("Realizar corte de caja");
        btnRealizarCorte.addActionListener(e -> {
            try {
                BigDecimal contado = Ui.leerMonto(txtEfectivoContado.getText());
                BigDecimal diferencia = cajaService.registrarCorte(turno, contado);

                String estadoDiferencia;
                int cmp = diferencia.compareTo(BigDecimal.ZERO);
                if (cmp > 0) {
                    estadoDiferencia = "Sobrante de " + Ui.dinero(diferencia);
                } else if (cmp < 0) {
                    estadoDiferencia = "Faltante de " + Ui.dinero(diferencia.abs());
                } else {
                    estadoDiferencia = "Sin diferencia (cuadre exacto)";
                }

                String resumen = "Corte registrado.\n"
                        + "Efectivo esperado: " + Ui.dinero(efectivoEsperado) + "\n"
                        + "Efectivo contado: " + Ui.dinero(contado) + "\n"
                        + "Resultado: " + estadoDiferencia;

                JOptionPane.showMessageDialog(this, resumen);
                refrescar();
            } catch (ReglaException ex) {
                Ui.error(this, ex.getMessage());
            } catch (SQLException ex) {
                Ui.error(this, "Error al guardar el corte: " + ex.getMessage());
            }
        });

        p.add(btnRealizarCorte, "growx 0, gaptop 6, h 38!");
        return p;
    }
}